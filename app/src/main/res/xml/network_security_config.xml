<?xml version="1.0" encoding="utf-8"?>
<!--
Allows plain HTTP only to the local trial backend (emulator host alias), instead of a blanket
cleartext-traffic-permitted app. Debug builds override this with src/debug's copy, which allows
any host so a physical device can reach this PC's LAN IP. The backend has no TLS yet because
it isn't hosted anywhere real (docs/BACKEND.md) - remove this once it is, and require HTTPS
everywhere (NFR: "secure API communication").
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
